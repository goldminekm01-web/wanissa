# Copy this file to .env and fill in your values

# App URL (your Vercel domain or ngrok for testing)
NEXT_PUBLIC_BASE_URL="https://your-project.vercel.app"

# M-Pesa Daraja API
MPESA_ENVIRONMENT="sandbox"           # change to "production" for live
MPESA_CONSUMER_KEY="your_consumer_key"
MPESA_CONSUMER_SECRET="your_consumer_secret"
MPESA_SHORTCODE="174379"              # sandbox shortcode; use 5002399 for production till
MPESA_PASSKEY="your_passkey"
MPESA_CALLBACK_URL="https://your-project.vercel.app/api/mpesa/callback"

# Africa's Talking SMS
AT_USERNAME="sandbox"
AT_API_KEY="your_api_key"
AT_SENDER_ID="your_sender_id"

# Database (Neon PostgreSQL — free at https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
